# Copy this file to .env. NEVER commit .env.
# The key is generated by the Obsidian Local REST API plugin.
OBSIDIAN_API_KEY=PASTE_YOUR_LOCAL_KEY_HERE
OBSIDIAN_BASE_URL=http://127.0.0.1:27123

# Local runtime. Models/audio stay outside Git.
RUPERT_RUNTIME=.runtime

# Optional overrides for whisper.cpp
# WHISPER_CPP_EXE=C:\path\to\whisper-cli.exe
# WHISPER_MODEL=C:\path\to\ggml-base.bin

# Piper TTS (Mexican Spanish, medium-size default)
PIPER_VOICE=es_MX-ald-medium
PIPER_DATA_DIR=.runtime/models/piper
